# ===== api 服务 =====
# 注意：NODE_ENV=production 下启动会做必须变量校验，缺下面任一硬性关键项直接启动失败
DATABASE_URL=postgresql://user:pass@host:5432/social_autopub
REDIS_URL=redis://host:6379
PORT=3000

# Notion
NOTION_TOKEN=secret_xxx

# LLM：默认 OpenRouter（OpenAI 兼容格式）
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-xxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 推理模型的 reasoning 预算；社媒短文通常 1000 足够，避免耗尽正文输出额度
OPENROUTER_REASONING_MAX_TOKENS=1000
GENERATION_MODEL=anthropic/claude-sonnet-4.5
# 直连 Anthropic 时改为：LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY + GENERATION_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-xxx

# Postiz（Railway 模板部署后的域名与 Settings 里生成的 API Key）
POSTIZ_API_URL=https://your-postiz.up.railway.app/api/public/v1
POSTIZ_API_KEY=xxx
# Postiz 实例的 JWT_SECRET（其部署环境变量），用于白标 OAuth 授权流（enterprise/url 签名与 webhook 验签）
POSTIZ_JWT_SECRET=xxx

# 本服务公网回拨地址（OAuth webhook 回调给 Postiz 用，必须可公网访问，不带尾部斜杠）
# Docker/自托管填：https://api.example.com ；Railway 旧变量 RAILWAY_PUBLIC_DOMAIN 自动兼容
PUBLIC_API_URL=https://api.example.com

# HTTP ingest 入口鉴权：key:来源名，逗号分隔多组
INGEST_API_KEYS=changeme-key-1:internal

# 管理接口鉴权（生产必填！未配置时管理接口无保护，仅日志告警）
# api 与 console 两个服务配置相同的值
ADMIN_API_KEY=changeme-admin-key

# 首个控制台管理员（users 表为空时启动自动创建）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-at-least-8-chars

# staging 置 true：发布到 Postiz 时只建草稿（type=draft），不真发
DRY_RUN=true

# true = 生成完成后直接发布（Notion 勾选 social_media_sent 即视为人工确认）
# false = 生成后进入控制台审核工作台，人工通过后才发布
AUTO_PUBLISH=false

# 允许跨域的前端域名
CONSOLE_URL=https://your-console.up.railway.app

# ===== console 服务 =====
# 服务端内网直连 api；Railway 填 http://api.railway.internal:3000；Docker Compose 已自动注入 http://api:3000
# API_INTERNAL_URL=http://api.railway.internal:3000
# 仅旧 Railway 配置的公网后备地址（有 API_INTERNAL_URL 时不需要，Docker 构建不要注入）
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
# 与 api 服务相同的管理密钥（仅存在于服务端，浏览器经 /api/proxy 转发）
ADMIN_API_KEY=changeme-admin-key
# Auth.js 会话签名密钥（openssl rand -hex 32 生成）
AUTH_SECRET=changeme-random-64-hex
AUTH_TRUST_HOST=true
